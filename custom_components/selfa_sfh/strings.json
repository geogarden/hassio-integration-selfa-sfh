{
  "title": "Selfa SFH",
  "config": {
    "step": {
      "user": {
        "title": "Selfa SFH – RS485 gateway",
        "description": "Connect directly to the RS485 gateway. Transparent serial server: rtu_over_tcp. Modbus TCP-to-RTU converter: tcp. Enter the gateway IP, not the ESPHome node IP. Default inverter unit ID: 247.",
        "data": {
          "host": "RS485 gateway host",
          "port": "Gateway port",
          "slave_id": "Inverter Modbus unit ID",
          "protocol": "Protocol"
        }
      },
      "reconfigure": {
        "title": "Selfa SFH – RS485 gateway",
        "description": "Connect directly to the RS485 gateway. Transparent serial server: rtu_over_tcp. Modbus TCP-to-RTU converter: tcp. Enter the gateway IP, not the ESPHome node IP. Default inverter unit ID: 247.",
        "data": {
          "host": "RS485 gateway host",
          "port": "Gateway port",
          "slave_id": "Inverter Modbus unit ID",
          "protocol": "Protocol"
        }
      }
    },
    "error": {
      "cannot_connect": "No response. Check host, port, protocol, unit ID and RS485 settings.",
